{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "FarmsDb": "Host=localhost;Port=5434;Database=farms_db;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "JwtSettings": {
    "Issuer": "CropConnect.Auth",
    "Audience": "CropConnect.Clients"
  },
  "Farms": {
    "MaxFarmsPerOwner": 10
  },
  "StockReservations": {
    "TimeToLive": "00:15:00",
    "SweepInterval": "00:01:00",
    "SweepBatchSize": 100,
    "MaxLinesPerOrder": 100,
    "EnableExpiryWorker": true
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}

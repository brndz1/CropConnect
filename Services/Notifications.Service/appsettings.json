{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "NotificationsDb": "Host=localhost;Database=notifications_db;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "JwtSettings": {
    "Issuer": "CropConnect.Auth",
    "Audience": "CropConnect.Clients"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5673,
    "VirtualHost": "/",
    "PrefetchCount": 10,
    "RetryDelay": "00:00:05"
  },
  "Email": {
    "Provider": "Mailpit",
    "FromAddress": "notifications@cropconnect.test",
    "FromName": "CropConnect",
    "PollInterval": "00:00:05",
    "BatchSize": 20,
    "MaxAttempts": 5,
    "RetryBaseDelay": "00:00:30",
    "Mailpit": {
      "BaseUrl": "http://localhost:8025/"
    },
    "Mailtrap": {
      "ApiToken": "",
      "SandboxInboxId": null
    }
  },
  "FarmsService": {
    "Url": "http://localhost:5002"
  },
  "AuthService": {
    "Url": "http://localhost:5298"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}

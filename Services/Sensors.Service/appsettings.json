{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "SensorsDb": "Host=localhost;Database=sensors_db;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "JwtSettings": {
    "Issuer": "CropConnect.Auth",
    "Audience": "CropConnect.Clients"
  },
  "SensorReadings": {
    "MaxClockSkew": "00:05:00",
    "AlertCooldown": "00:30:00"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5673,
    "VirtualHost": "/",
    "PrefetchCount": 10,
    "RetryDelay": "00:00:05"
  },
  "Outbox": {
    "PollInterval": "00:00:02",
    "BatchSize": 50
  },
  "OpenMeteo": {
    "BaseUrl": "https://api.open-meteo.com/",
    "Timeout": "00:00:05",
    "ForecastHours": 24
  },
  "FarmsService": {
    "Url": "http://localhost:5002"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}

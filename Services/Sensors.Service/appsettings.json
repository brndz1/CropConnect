{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "SensorsDb": "Host=localhost;Port=5436;Database=sensors_db;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "JwtSettings": {
    "Issuer": "CropConnect.Auth",
    "Audience": "CropConnect.Clients"
  },
  "SensorReadings": {
    "MaxClockSkew": "00:05:00",
    "AlertCooldown": "00:30:00"
  },
  "FarmsService": {
    "Url": "http://localhost:5002",
    "ApiKey": "dev-internal-api-key-change-me-0123456789"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}

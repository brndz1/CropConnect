{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "AuthDb": "Host=localhost;Database=auth_db;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Issuer": "CropConnect.Auth",
    "Audience": "CropConnect.Clients",
    "ExpirationMinutes": "60"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5673,
    "VirtualHost": "/"
  },
  "Outbox": {
    "PollInterval": "00:00:02",
    "BatchSize": 50
  },
  "Accounts": {
    "RequireVerifiedEmail": true,
    "EmailVerificationLifetime": "1.00:00:00",
    "PasswordResetLifetime": "01:00:00",
    "InvitationLifetime": "3.00:00:00",
    "ResendCooldown": "00:01:00"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}

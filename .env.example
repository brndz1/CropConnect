# Copy to .env to override the development defaults of compose.yaml.
GATEWAY_PORT=5000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5440
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
JWT_SECRET=SuperSecretKeyForDevelopmentOnly12345!
INTERNAL_API_KEY=dev-internal-api-key-change-me-0123456789
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cropconnect.test
ADMIN_PASSWORD=DevAdmin-ChangeMe-123
# Notification emails: Mailpit (local, http://localhost:8025) or Mailtrap (needs an API token).
EMAIL_PROVIDER=Mailpit
EMAIL_FROM_ADDRESS=notifications@cropconnect.test
MAILPIT_UI_PORT=8025
MAILTRAP_API_TOKEN=
# Set to deliver into a Mailtrap sandbox inbox instead of real recipients.
MAILTRAP_SANDBOX_INBOX_ID=

# Aspire dashboard (logs, traces, metrics), published on 127.0.0.1 only
DASHBOARD_PORT=18888

# Sensor simulator (Node-RED), only with --profile simulation
SIMULATOR_PORT=1881

# Copy to .env to override the development defaults of compose.yaml.
GATEWAY_PORT=5000
# Web app
WEB_PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5440
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
JWT_SECRET=SuperSecretKeyForDevelopmentOnly12345!
INTERNAL_API_KEY=dev-internal-api-key-change-me-0123456789
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cropconnect.test
ADMIN_PASSWORD=DevAdmin-ChangeMe-123
# Emails (notifications and account emails): Mailpit (local, http://localhost:8025) or Smtp.
EMAIL_PROVIDER=Mailpit
# With Smtp, a sender verified in that provider's account.
EMAIL_FROM_ADDRESS=noreply@cropconnect.test
# The web app the links in the emails open.
APP_BASE_URL=http://localhost:3000/
# true with real delivery: addresses on reserved test domains (*.test, example.com) are not sent.
EMAIL_SKIP_RESERVED_DOMAINS=false
MAILPIT_UI_PORT=8025
# EMAIL_PROVIDER=Smtp, e.g. Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, its SMTP login and key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Aspire dashboard (logs, traces, metrics), published on 127.0.0.1 only
DASHBOARD_PORT=18888

# Sensor simulator (Node-RED), only with --profile simulation
SIMULATOR_PORT=1881

@Gateway = http://localhost:5000

### Log in as the development administrator; paste the token below
POST {{Gateway}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@cropconnect.test",
  "password": "DevAdmin-ChangeMe-123"
